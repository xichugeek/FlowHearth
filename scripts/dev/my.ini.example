[mysqld]
basedir=C:/path/to/mysql-8.4.x-winx64
datadir=C:/path/to/flowhearth/mysql-data
port=3306
bind-address=127.0.0.1
mysqlx=0
skip-name-resolve
skip-log-bin
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
default-time-zone=+00:00
local-infile=0
secure-file-priv=C:/path/to/flowhearth/mysql-files
log-error=C:/path/to/flowhearth/mysql-error.log
pid-file=C:/path/to/flowhearth/mysql.pid
max-connections=50
innodb-buffer-pool-size=128M

[client]
host=127.0.0.1
port=3306
protocol=tcp
default-character-set=utf8mb4
